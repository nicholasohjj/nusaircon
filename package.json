{
  "name": "evs-meter-tools",
  "version": "1.0.0",
  "description": "EVS electricity top-up Telegram bot with eNETS payment WebApp",
  "license": "MIT",
  "main": "server.js",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "npm run install:frontend && npm run build:frontend",
    "install:frontend": "npm ci --prefix frontend",
    "build:frontend": "npm run build --prefix frontend",
    "dev:frontend": "npm run dev --prefix frontend",
    "lint": "npm run lint:backend && npm run lint --prefix frontend",
    "lint:backend": "eslint .",
    "lint:fix": "npm run lint:backend -- --fix && npm run lint:fix --prefix frontend",
    "format": "prettier . --write",
    "test": "vitest run",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "axios": "^1.15.0",
    "axios-cookiejar-support": "^7.0.0",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "marked": "^18.1.3",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "posthog-node": "^5.63.1",
    "swagger-ui-express": "^5.0.1",
    "telegraf": "^4.16.3",
    "tough-cookie": "^6.1.0",
    "yamljs": "^0.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.1",
    "globals": "^17.14.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "supertest": "^7.3.2",
    "vitest": "^5.1.0"
  }
}
